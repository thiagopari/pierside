# One switch: MOCK=1 fakes Claude and PayPal (no keys needed), MOCK=0 requires real keys,
# unset = mock whichever side has no keys.
MOCK=1

# PayPal developer dashboard -> Apps & Credentials -> Sandbox -> your app
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# PAYPAL_BASE=https://api-m.sandbox.paypal.com

# console.anthropic.com -> API keys (set a monthly spend limit on the workspace)
ANTHROPIC_API_KEY=
MODEL=claude-haiku-5-5

# Render Workflows (optional): unset = jobs.py tasks run in-process.
# Local runtime: render workflows dev -- .venv/bin/python jobs.py, plus RENDER_USE_LOCAL_DEV=1 here.
# WORKFLOW_SLUG=pierside-jobs
# RENDER_API_KEY=

# Bearer token for POST /api/ops/complete (operator marks a dive done; PayPal then emails the balance invoice)
OPS_TOKEN=

# Cost guards for the public demo
PER_IP_HOURLY=40
DAILY_MODEL_CALLS=600
